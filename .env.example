# ---------------------------------------------------------------------------
# Client configuration
# These values are bundled into the app. Only use the publishable/anon key.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---------------------------------------------------------------------------
# Server-side / local admin configuration
# Used only by scripts/sync-supabase.mjs. Never prefix these with EXPO_PUBLIC_.
# Never commit the real values.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
